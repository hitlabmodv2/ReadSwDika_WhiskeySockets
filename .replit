modules = ["nodejs-20", "bash", "python-3.12", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WhatsApp Bot"

[[workflows.workflow]]
name = "WhatsApp Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pm2 delete wily-bot 2>/dev/null; pm2 start ecosystem.config.cjs && pm2 monit"

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
